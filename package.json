{
  "name": "wavr",
  "productName": "WAVR",
  "description": "WAVR is a beautiful desktop music player for Navidrome and Subsonic-compatible servers.",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "npm run build:renderer && npm run build:main && npm run build:native && electron .",
    "dist:linux": "electron-builder --linux deb",
    "dev": "npm run build:main && npm run build:native && node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:main && npm run build:native && electron-builder",
    "prebuild:renderer": "node scripts/strip-json-bom.mjs",
    "build:renderer": "vite build",
    "prebuild:main": "node scripts/strip-json-bom.mjs",
    "build:main": "node scripts/build-electron.mjs",
    "build:native": "node scripts/build-native.mjs",
    "wavrsync": "npm --prefix wavrsync-server start",
    "wavrsync:dev": "npm --prefix wavrsync-server run dev",
    "wavrsync:install": "npm --prefix wavrsync-server install",
    "updates": "node wavr-update-server/server.mjs",
    "updates:dev": "node --watch wavr-update-server/server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "wavr",
    "music-player",
    "navidrome",
    "subsonic",
    "opensubsonic",
    "electron",
    "material-design",
    "desktop"
  ],
  "author": "slafoni",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "app.wavr.desktop",
    "productName": "WAVR",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "src/dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "bin"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "maintainer": "slafoni"
    },
    "deb": {
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2",
        "libpipewire-0.3-0"
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    }
  },
  "version": "1.0.23dev",
  "homepage": "https://listenwavr.xyz",
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
